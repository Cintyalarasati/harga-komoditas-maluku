        "lint:js": "eslint \"js/**/*.js\"",
        "lint:css": "stylelint \"css/**/*.css\"",
        "lint": "npm run lint:js && npm run lint:css"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Cintyalarasati/harga-komoditas-maluku.git"
    },
