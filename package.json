{
    "name": "harga-komoditas-maluku",
    "version": "1.0.0",
    "description": "Website informasi harga komoditas lokal di wilayah Seram Bagian Barat (SBB), Maluku.",
    "private": true,
    "main": "index.js",
    "scripts": {
        "format": "prettier --write \"css/**/*.css\" \"js/**/*.js\" \"README.md\" \"*.json\"",
